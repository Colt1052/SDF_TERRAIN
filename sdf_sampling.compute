# Compute Shader for SDF Sampling
# Each thread processes one lattice point

dispatch:
- name: sdf_sampling
  type: compute
  backend: gpu
  chunk_size: 16
  threads:
    x: 64
    y: 64

def sdf_calc(thread_x, thread_y):
    pos_x = chunk_origin_x + thread_x * lattice_step
    pos_y = chunk_origin_y + thread_y * lattice_step

    # Calculate SDF: distance from center minus radius
    dist = ((pos_x - edit_x)^2 + (pos_y - edit_y)^2)^0.5

    if edit_additive:
        sdf = dist - edit_radius
    else:
        sdf = edit_radius - dist

    return sdf

def marching_squares(s00, s01, s10, s11):
    # Marching squares algorithm to generate vertices/triangles
    cases = (int(s00 > 0) << 3) | (int(s01 > 0) << 2) | \
            (int(s10 > 0) << 1) | (int(s11 > 0))

    match cases:
        case 1:
            emit_edge(1, 2)
        case 2:
            emit_edge(1, 3)
        case 3:
            emit_edge(1, 2); emit_edge(1, 3)
        # ... other cases
        case _:
            pass

def emit_vertex(x, y, z):
    output_vertex(x, y, z)

def emit_edge(p1, p2):
    if p1 == 1 and p2 == 2:
        output_edge(top_left, top_right)
    # ... other edge mappings
